Adds LOCALJEV_UPSTREAM_EXTRA_BODY: a JSON object merged into every upstream
chat-completion body. Needed with Ollama to send {"reasoning_effort":"none"},
otherwise thinking models (Gemma 4, Qwen 3.x) reason before answering (~20-40 s).

--- a/src/config.ts
+++ b/src/config.ts
@@ -13,4 +13,5 @@
   maxQueue: number;
   questionsPerCall: number;
   outcomesPerCall: number;
+  upstreamExtraBody: Record<string, unknown>;
 }
@@ -63,5 +64,8 @@
       "LOCALJEV_OUTCOMES_PER_CALL",
       128,
       1,
     ),
+    upstreamExtraBody: JSON.parse(
+      process.env.LOCALJEV_UPSTREAM_EXTRA_BODY ?? "{}",
+    ) as Record<string, unknown>,
     ...overrides,
--- a/src/engine.ts
+++ b/src/engine.ts
@@ -423,5 +423,6 @@
             strict: true,
             schema,
           },
         },
+        ...this.settings.upstreamExtraBody,
       };
